# Copy to config/paths.env and replace every value for your environment.
# This file documents the path concepts used by the legacy scripts; scripts do
# not source it automatically until they have been refactored for your system.

SHEEP_GENOME_FASTA=/path/to/GCF_016772045.1_ARS-UI_Ramb_v2.0_genomic.fna
SHEEP_CHROM_SIZES=/path/to/sheep.chrom.sizes
SHEEP_BOWTIE2_INDEX=/path/to/bowtie2/sheep_index
SHEEP_TO_HG38_CHAIN=/path/to/GCF_016772045.2ToHg38.over.chain.gz
HUMAN_TO_SHEEP_CHAIN=/path/to/hg38ToGCF_016772045.2.over.chain.gz
SHEEP_V3_CHROM_MAP=/path/to/v3NCtochr.txt
HUMAN_HG38_CHROMATIN_STATES=/path/to/human_hg38_chromatin_states
SHEEP_V3_CHROMATIN_STATES=/path/to/sheep_v3_chromatin_states
GENE_ANNOTATION_BED=/path/to/sheep_gene_annotation.bed
CDS_ANNOTATION_BED=/path/to/sheep_cds_annotation.bed

RAW_DATA_ROOT=/path/to/raw_data
ANALYSIS_ROOT=/path/to/analysis
REFERENCE_ROOT=/path/to/references
SOFTWARE_ROOT=/path/to/software
FIGURE_OUTPUT_ROOT=/path/to/figures

CHROMIMPUTE_JAR=/path/to/ChromImpute.jar
CHROMHMM_JAR=/path/to/ChromHMM.jar
PHANTOMPEAKQUALTOOLS_R=/path/to/phantompeakqualtools/run_spp.R

